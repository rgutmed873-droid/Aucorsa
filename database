DROP DATABASE IF exists Aucorsa;
CREATE DATABASE Aucorsa;
USE Aucorsa;
-- Tabla Bus
CREATE TABLE Bus (
    matricula VARCHAR(10) PRIMARY KEY,
    tipo VARCHAR(20),
    licencia VARCHAR(20)
);

-- Tabla Driver
CREATE TABLE Conductor (
    numConductor INT PRIMARY KEY,
    nombre VARCHAR(50),
    apellido VARCHAR(50),
    imagen VARCHAR(50)
);

-- Tabla Place
CREATE TABLE Lugar (
    idLugar INT PRIMARY KEY,
    cp VARCHAR(10),
    ciudad VARCHAR(50),
    lugar VARCHAR(50)
);

-- Tabla intermedia B-D-P (relación ternaria)
-- Tabla ternaria Routes (Bus + Conductor + Lugar)
CREATE TABLE Routes (
    matricula      VARCHAR(10) NOT NULL,
    numConductor   INT         NOT NULL,
    idLugar        INT         NOT NULL,
    diaSemana      VARCHAR(15) NOT NULL,
    PRIMARY KEY (matricula, numConductor, idLugar),
    FOREIGN KEY (matricula)    REFERENCES Bus(matricula),
    FOREIGN KEY (numConductor) REFERENCES Conductor(numConductor),
    FOREIGN KEY (idLugar)      REFERENCES Lugar(idLugar)
);


